# Everything is optional. With no .env the app runs against DraftKings New Jersey.

# Jurisdiction. Keep the three in step: US-NJ-SB / dkusnj / sportsbook-ws-us-nj.draftkings.com
# or CA-ON-SB / dkcaon / sportsbook-ws-ca-on.draftkings.com (Ontario).
# DK_REST_SITE=US-NJ-SB
# DK_WS_SITE=dkusnj
# DK_WS_HOST=sportsbook-ws-us-nj.draftkings.com

# ClickHouse: line history on the page, plus analytics for Grafana. Unset = disabled.
# Local (docker compose up -d): http://localhost:8123, password "odds".
# ClickHouse Cloud: https://<service>.<region>.aws.clickhouse.cloud:8443, user "default".
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=odds
# CLICKHOUSE_DATABASE=default

# "Source code" link in the page footer (defaults to the GitHub repo).
# NEXT_PUBLIC_REPO_URL=https://github.com/Twoos123/draftkings-live-odds
